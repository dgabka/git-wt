#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 1 || ! $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; then
  echo "usage: scripts/release VERSION (for example: 0.2.0)" >&2
  exit 2
fi

if [[ -n $(git status --porcelain) ]]; then
  echo "working tree must be clean" >&2
  exit 1
fi

version=$1
tag="v$version"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "tag $tag already exists" >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
awk -v version="$version" '
  !changed && /^[[:space:]]*version = "[^"]*";/ {
    sub(/"[^"]*"/, "\"" version "\"")
    changed = 1
  }
  { print }
  END { if (!changed) exit 1 }
' flake.nix > "$tmp"
mv "$tmp" flake.nix

./test.sh
nix build --no-link .#wt
git add flake.nix
git commit -m "chore: release $tag"
git tag -a "$tag" -m "$tag"

echo "created $tag; publish with: git push origin HEAD $tag"
